{
  "resistor": {
    "type": "model",
    "ports": ["ref", "p"],
    "parameters": ["resistance"],
    "equations": ["U_p - resistance * I_p"]
  },
  "capacitor": {
    "type": "model",
    "ports": ["ref", "p"],
    "parameters": ["capacitance"],
    "equations": ["I_p - capacitance * Udot_p"]
  },
  "inductor": {
    "type": "model",
    "ports": ["ref", "p"],
    "parameters": ["inductance"],
    "equations": ["U_p - inductance * Idot_p"]
  },
  "voltage_source": {
    "type": "model",
    "ports": ["ref", "p"],
    "parameters": ["voltage"],
    "equations": ["U_p - voltage"]
  },
  "current_source": {
    "type": "model",
    "ports": ["ref", "p"],
    "parameters": ["current"],
    "equations": ["I_p - current"]
  }
}
